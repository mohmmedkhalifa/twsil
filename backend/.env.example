# Server
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000

# JWT
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# Database (default: SQLite for development)
DATABASE_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=twsil
# When DATABASE_TYPE=postgres, set:
# DB_HOST, DB_PORT=5432, DB_USERNAME, DB_PASSWORD, DB_NAME

# Admin seed (npm run seed)
ADMIN_PHONE=0599999999
ADMIN_PASSWORD=Admin@12345

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Business rules
SUBSCRIPTION_FEE=10
SERVICE_FEE=1
BASE_DELIVERY_FEE=5
FEE_PER_KM=2
# Push notifications (Firebase Cloud Messaging)
# Either inline JSON or a path to the service-account JSON file
# (Firebase Console > Project settings > Service accounts > Generate new private key)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Image storage driver: local (server disk) | s3 (S3-compatible bucket)
STORAGE_DRIVER=local
# When STORAGE_DRIVER=s3:
# Supabase Storage: endpoint + S3 keys from Project Settings -> Storage -> S3 Access Keys
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_BUCKET=twsil-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/twsil-images
S3_FORCE_PATH_STYLE=true

# Supabase (serverless/Cloud Functions): use the Transaction pooler
# Project Settings > Database > Connection string > "Transaction pooler" tab
# DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# DB_PORT=6543
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<database password>
# DB_NAME=postgres
# DB_SSL=true
# DB_POOL_MAX=10
